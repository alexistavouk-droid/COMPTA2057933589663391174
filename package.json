{
  "name": "compta-elina",
  "productName": "Compta Elina",
  "version": "2.0.0",
  "description": "Comptabilité et gestion commerciale pour startups et commerces (web et Windows)",
  "main": "main.js",
  "author": "Compta Elina",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "stamp": "node scripts/stamp.js",
    "e2e": "electron scripts/e2e.js",
    "manual": "electron scripts/capture.js",
    "predist:win": "npm run stamp && npm test",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "fr.elina.compta",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Compta Elina",
      "uninstallDisplayName": "Compta Elina"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      },
      "category": "public.app-category.finance"
    },
    "artifactName": "Compta-Elina-Setup-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  }
}
